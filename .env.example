# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Upstash Redis
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Proxy-seller.com ISP proxies
# Format: host:port:user:pass per line as JSON array
PROXIES_JSON=[{"host":"","port":0,"user":"","pass":"","geo":"US"},{"host":"","port":0,"user":"","pass":"","geo":"GB"}]

# Worker auth
WORKER_SECRET=your_worker_secret

# App
NEXT_PUBLIC_APP_URL=https://pulsebooster.net

# Anthropic (for Brain)
ANTHROPIC_API_KEY=your_anthropic_key

# Delivery config
MAX_SESSIONS_PER_IP_WEB=300
MAX_SESSIONS_PER_IP_SOCIAL=30
SESSION_SPACING_MIN_MS=900000
DAILY_BUFFER=1.25
